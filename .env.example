# Centralized Environment Variables Template
# Copy this file to apps/backend/.env

# Port Configuration
PORT=4000

# PostgreSQL Database Connections (Supabase or Neon.tech)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# Upstash Redis Connection for BullMQ Job Queue
REDIS_HOST="your-redis-host.upstash.io"
REDIS_PORT=6379
REDIS_PASSWORD="your-redis-password"
REDIS_URL="rediss://default:your-redis-password@your-redis-host.upstash.io:6379"
REDIS_TLS=true

# Upstash Redis REST API
UPSTASH_REDIS_REST_URL="https://your-redis-host.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-rest-token"

# Google AI Studio API Key (Gemini 2.5 Flash Free Tier)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Next.js Public Backend API Address
NEXT_PUBLIC_API_URL="http://localhost:4000/api"